{
  "name": "politicalfunding-guide",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run data && astro build",
    "build:only": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "data": "npm run fetch:law && npm run fetch:villages && npm run fetch:parties && npm run fetch:donations && npm run build:regions && npm run build:datasets && npm run build:media",
    "fetch:law": "node scripts/fetch-law.mjs",
    "fetch:villages": "node scripts/fetch-villages.mjs",
    "fetch:parties": "node scripts/fetch-parties.mjs",
    "build:regions": "node scripts/build-regions.mjs",
    "build:datasets": "node scripts/build-datasets.mjs",
    "check:links": "node scripts/check-links.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "shot": "node scripts/screenshot.mjs",
    "fetch:donations": "node scripts/fetch-donations.mjs",
    "build:media": "node --experimental-strip-types scripts/build-media.mjs && node --experimental-strip-types scripts/build-media-zip.mjs",
    "signal": "node scripts/news-signal.mjs",
    "check:dates": "node scripts/check-dates.mjs",
    "stat": "node scripts/stat.mjs",
    "audit:prose": "node scripts/audit-prose.mjs",
    "audit:paraphrase": "node scripts/audit-paraphrase.mjs",
    "audit:tone": "node scripts/audit-ai-tone.mjs",
    "audit": "npm run audit:prose && npm run audit:paraphrase && npm run audit:tone",
    "banner": "node scripts/build-banner.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "astro": "^7.2.9",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.4.0",
    "qrcode": "^1.5.4",
    "typescript": "^6.0.3"
  }
}
