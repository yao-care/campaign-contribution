---
/**
 * 資料來源與更新日（§9.3）。法規內容沒有日期與署名不會被 AI 引擎引用（§9.1 第 5 條）。
 */
export interface Props {
  updated: Date;
  reviewer: string;
  sources: { label: string; href: string }[];
}
const { updated, reviewer, sources } = Astro.props;
// updated 是抓取當下的真實時刻，不是純日期，所以指定台北時區呈現，
// 不能用建置機器的本地時區（CI 是 UTC，會少一天）。
const tp = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit',
}).format(updated);
const [y, m, d] = tp.split('-').map(Number);
const iso = tp;
const roc = `民國 ${y - 1911} 年 ${m} 月 ${d} 日`;
---
<footer class="provenance">
  <p>
    最後更新：<time datetime={iso}>{iso}（{roc}）</time>｜審閱：{reviewer}
  </p>
  <p>
    資料來源：
    {sources.map((s, i) => (
      <>{i > 0 && <span>、</span>}<a href={s.href} rel="noopener">{s.label}</a></>
    ))}
  </p>
</footer>
