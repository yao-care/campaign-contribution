---
import { REVIEWER } from '../site.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import KeyPoints from '../components/KeyPoints.astro';
import Provenance from '../components/Provenance.astro';
import lawData from '../data/law.json';
import villagesData from '../data/villages.json';
import partyData from '../data/parties.json';
import { LOCAL_CYCLE } from '../data/elections';
import { UPDATES_SORTED, KIND_LABEL } from '../data/updates';

---
<BaseLayout
  title="制度與資料異動紀錄"
  description="政治獻金法的規則變動、主管機關公告，以及本站各項資料的抓取時間與期別。提供 Atom 訂閱。"
  crumbs={[{ name: '制度與資料異動', href: '/updates/' }]}
>
  <h1>制度與資料異動</h1>
  <KeyPoints points={[
    `法條原文最後抓取日為 ${lawData.fetchedAt.slice(0, 10)}，指紋 ${lawData.digest}。`,
    `村里資料採用內政部戶政司 ODRP001 期別 ${villagesData.period}，共 ${villagesData.count.toLocaleString('zh-TW')} 筆。`,
    `本屆收受起算日以監察院 115 年 2 月 9 日公告為準，非由任期屆滿日推算。`,
  ]} />
  <ol class="log">
    {UPDATES_SORTED.map((e) => (
      <li>
        <p class="meta"><time datetime={e.d}>{e.d}</time><span class={`k k--${e.kind}`}>{KIND_LABEL[e.kind]}</span></p>
        <h2>{e.t}</h2>
        <p>{e.b}</p>
      </li>
    ))}
  </ol>
  <p class="sub">
    這條時間軸把主管機關的公告與本站的抓取紀錄放在一起，因為「這條規則什麼時候變的」
    是下一屆選舉回來時最難查的東西。可用 <a href="/updates.xml">Atom 訂閱</a>，
    不必等本站主動通知。
  </p>

  <p class="note">
    尚待更新的項目：本屆各行政區應選名額與選舉區劃分（待中央選舉委員會選舉公告）、
    村里戶籍人口（尚無可用開放資料集）。
  </p>
  <Provenance updated={new Date(lawData.fetchedAt)} reviewer={REVIEWER}
    sources={[
      { label: '全國法規資料庫．政治獻金法', href: lawData.source },
      { label: '監察院陽光法令主題網', href: LOCAL_CYCLE.source },
      { label: '內政部政黨資訊網', href: partyData.source },
    ]} />
</BaseLayout>
<style>
  .log { list-style:none; padding:0; }
  .log li { border-inline-start:3px solid var(--rule); padding:0 0 1.5rem 1.25rem; }
  .log .meta { display:flex; align-items:center; gap:.75em; margin:0; }
  .log time { font-size:var(--text-xs); color:var(--muted); font-variant-numeric:tabular-nums; }
  .log .k { font-size:var(--text-xs); border:1px solid var(--rule); padding:.1em .5em; color:var(--ink-2); }
  .log .k--rule { border-color:var(--stamp); color:var(--stamp); }
  .log h2 { margin-block:.2em .4em; font-size:var(--text-lg); }
  .log p { margin:0; font-size:var(--text-sm); color:var(--ink-2); }
</style>
