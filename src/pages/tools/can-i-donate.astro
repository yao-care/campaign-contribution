---
import { REVIEWER } from '../../site.mjs';
/**
 * T5 工具頁：逐題資格檢核。
 *
 * 建站規格 §1 硬性要求：答案必須存在於 HTML 中。因此本頁的完整規則
 * 以靜態表單與表格呈現，零 JS 即可讀完並自行判斷；那段 script 只是把
 * 已勾選的答案彙整成一句結論，不產生任何新資訊，也不送出任何資料。
 * 無障礙：每題一個 fieldset/legend，結論區 aria-live。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import KeyPoints from '../../components/KeyPoints.astro';
import Provenance from '../../components/Provenance.astro';
import NextQuestions from '../../components/NextQuestions.astro';
import Statute from '../../components/Statute.astro';
import { DONORS, MAJOR_MEMBER_TESTS } from '../../data/donors';
import lawData from '../../data/law.json';
---
<BaseLayout
  title="我可以捐政治獻金嗎？逐題檢核第 7 條 11 款"
  description="依政治獻金法第 7 條逐題檢核捐贈資格。得捐贈者以個人、政黨、人民團體及營利事業為限，且不得屬於第 7 條第 1 項所列 11 款排除對象。"
  crumbs={[{ name: '工具', href: '/tools/' }, { name: '我可以捐嗎', href: '/tools/can-i-donate/' }]}
  jsonld={[{
    '@context': 'https://schema.org',
    '@type': ['WebPage', 'SoftwareApplication'],
    name: '政治獻金捐贈資格檢核',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Web',
    inLanguage: 'zh-Hant-TW',
    about: { '@type': 'Legislation', name: '政治獻金法第 7 條' },
  }]}
>
  <h1>我可以捐政治獻金嗎？</h1>

  <KeyPoints points={[
    '得捐贈者以個人、政黨、人民團體及營利事業為限（第 7 條第 1 項本文）。',
    '即使身分符合，仍不得屬於第 7 條第 1 項所列 11 款排除對象中的任何一款。',
    '本檢核在你的瀏覽器內完成，不會傳送任何資料，也不會儲存你的答案。',
  ]} />

  <p class="lede">
    兩個關卡：先看身分是否屬於得捐贈的四種，再看是否落入 11 款排除對象。
    任何一款成立，就不得捐贈。
  </p>

  <h2>第一關：你的身分屬於得捐贈者嗎？</h2>
  <p>
    第 7 條第 1 項本文限定得捐贈者為個人、政黨、人民團體及營利事業。
    不屬於這四種身分者，一律不得捐贈政治獻金。
  </p>

  <h2>第二關：逐款檢核 11 款排除對象</h2>
  <p>以下 11 題，任何一題答「是」，即不得捐贈。全部答「否」才符合資格。</p>

  <form id="check" novalidate>
    {DONORS.map((d) => (
      <fieldset class="q">
        <legend>
          第 {d.clause} 款：{d.scope}
        </legend>
        {d.exception && <p class="exc">例外：{d.exception}</p>}
        <div class="opts">
          <label>
            <input type="radio" name={`c${d.clause}`} value="yes" />
            <span>是，符合這一款</span>
          </label>
          <label>
            <input type="radio" name={`c${d.clause}`} value="no" />
            <span>否</span>
          </label>
        </div>
        <p class="agency">查證機關：{d.verifyAgency.join('、')}｜<a href={`/donors/${d.slug}/`}>這一款的詳細說明</a></p>
      </fieldset>
    ))}
  </form>

  <section class="verdict" aria-labelledby="verdict-h">
    <h2 id="verdict-h">檢核結果</h2>
    <p id="verdict" aria-live="polite">
      尚未作答。上方 11 題全部答「否」者，未落入第 7 條第 1 項任何一款排除對象；
      任何一題答「是」者，不得捐贈政治獻金。
    </p>
  </section>

  <h2>第 7、8、9 款的「主要成員」怎麼認定？</h2>
  <p>第 7 條第 3 項定義三種情形，符合任何一種即為主要成員：</p>
  <ol>{MAJOR_MEMBER_TESTS.map((t) => <li>{t}</li>)}</ol>

  <h2>通過檢核之後呢？</h2>
  <p>
    資格只是第一關。還要確認：受贈方是否已經過許可設立專戶（第 10 條）、
    是否在法定收受期間內（第 12 條）、捐贈金額是否超過上限（第 17、18 條），
    以及捐贈方式是否合法——不得以他人名義捐贈，匿名捐贈逾 1 萬元不得收受，
    現金捐贈逾 10 萬元應以支票或匯款為之（第 14 條）。
  </p>

  <Statute article="7" />

  <NextQuestions items={[
    { q: '我可以捐多少？', href: '/tools/limit/' },
    { q: '受贈方什麼時候才可以收？', href: '/tools/timeline/' },
    { q: '捐了可以抵稅嗎？', href: '/tools/deduction/individual/' },
    { q: '違法捐贈的罰則是什麼？', href: '/tools/penalty/29/' },
  ]} />

  <Provenance updated={new Date(lawData.fetchedAt)} reviewer={REVIEWER}
    sources={[{ label: '全國法規資料庫．政治獻金法', href: lawData.source }]} />
</BaseLayout>

<script is:inline>
  // 純前端彙整，不送出、不儲存。零 JS 時上方靜態內容已足以自行判斷。
  (function () {
    var form = document.getElementById('check');
    var out = document.getElementById('verdict');
    if (!form || !out) return;
    var total = form.querySelectorAll('fieldset.q').length;
    form.addEventListener('change', function () {
      var yes = [], answered = 0;
      for (var i = 1; i <= total; i++) {
        var picked = form.querySelector('input[name="c' + i + '"]:checked');
        if (!picked) continue;
        answered++;
        if (picked.value === 'yes') yes.push(i);
      }
      if (yes.length) {
        out.textContent = '不得捐贈。你符合第 7 條第 1 項第 ' + yes.join('、') +
          ' 款，屬於不得捐贈政治獻金者。若仍捐贈，依第 29 條第 2 項按捐贈金額處 2 倍以下罰鍰，且該筆捐贈不得列為列舉扣除額。';
        out.className = 'no';
      } else if (answered === total) {
        out.textContent = '未落入第 7 條第 1 項任何一款排除對象。接下來仍須確認受贈方已設立專戶、在法定收受期間內，且捐贈金額未超過第 17、18 條的上限。';
        out.className = 'ok';
      } else {
        out.textContent = '已作答 ' + answered + ' / ' + total + ' 題。任何一題答「是」即不得捐贈。';
        out.className = '';
      }
    });
  })();
</script>

<style>
  .lede { font-size: var(--text-lg); color: var(--ink-2); }
  .q {
    border: 1px solid var(--rule);
    border-inline-start: 3px solid var(--slate);
    padding: 1em 1.25em; margin-block: 1rem;
  }
  .q legend { font-weight: 600; padding-inline: .4em; font-size: var(--text-sm); }
  .opts { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-block: .75em; }
  .opts label { display: inline-flex; align-items: center; gap: .5em; cursor: pointer; }
  .opts input { width: 1.2em; height: 1.2em; accent-color: var(--stamp); }
  .exc, .agency { font-size: var(--text-xs); color: var(--muted); margin-block: .4em; }
  .verdict {
    border: 2px solid var(--ink); padding: 1.25em;
    margin-block: 2rem; background: var(--alt);
  }
  .verdict h2 { margin-block: 0 .5em; font-size: var(--text-lg); }
  #verdict { margin: 0; }
  #verdict.no { color: var(--stamp); font-weight: 700; }
  #verdict.ok { color: var(--slate); font-weight: 700; }
</style>
